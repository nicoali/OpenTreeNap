# modern-v4.1 is a development/bridge deployment, not a final production config.
OTM_DB_NAME=otm
OTM_DB_USER=otm
OTM_DB_PASSWORD=otm
OTM_DB_HOST=db
OTM_DB_PORT=5432
OTM_REDIS_URL=redis://redis:6379/0
OTM_CACHE_URL=redis://redis:6379/1

# Replace for any non-local deployment.
OTM_SECRET_KEY=change-me-before-production
OTM_DEBUG=1
OTM_ALLOWED_HOSTS=*
OTM_HTTP_PORT=8000
OTM_TILER_HTTP_PORT=4000

OTM_STATIC_ROOT=/tmp/otm/static
OTM_MEDIA_ROOT=/tmp/otm/media
# Optional host path for production media serving through Caddy.
# OTM_MEDIA_HOST_PATH=/srv/opentreenap/media

# Optional external integrations
GOOGLE_MAPS_KEY=
ESRI_CLIENT_ID=
ESRI_CLIENT_SECRET=

# Reverse-geocode fallback used when Esri credentials are unavailable.
# Public Nominatim is suitable only for light, user-triggered use; the backend
# rate-limits and caches calls. Point this at another provider/self-hosted
# instance later without requiring an Android app update.
OTN_NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
OTN_NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
OTN_NOMINATIM_USER_AGENT=OpenTreeNap/0.7 (+https://opentreenap.altervista.org/)
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
ROLLBAR_SERVER_SIDE_ACCESS_TOKEN=
ROLLBAR_POST_CLIENT_ITEM_ACCESS_TOKEN=

# 1 can be useful while debugging backend startup before touching Webpack.
OTM_SKIP_FRONTEND_BUILD=0
OTM_FORCE_FRONTEND_BUILD=0

# Browser-visible URL of the OTM tile renderer.
# Local Docker development:
OTM_TILE_HOST=//localhost:4000

# Dedicated legacy PostgreSQL login used only by OTM Tiler.
# Replace this value locally; do not commit the real password.
OTM_TILER_DB_USER=otm_tiler
OTM_TILER_DB_PASSWORD=change-me-locally
