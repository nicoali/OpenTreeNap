# Legacy frontend dependency stage.
# Node 14 is intentionally isolated here because the original Webpack 1 /
# node-sass 4 toolchain is not compatible with current Node releases.
FROM node:14.21.3-bullseye AS frontend-deps

WORKDIR /frontend
COPY package.json /frontend/
RUN npm install --legacy-peer-deps --no-audit --no-fund

# Python/Django bridge runtime on Debian 12 (Bookworm).
# Bullseye reached LTS EOL on 2026-08-31 and its security repository is
# currently unsuitable for reproducible apt builds.
FROM python:3.10-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DJANGO_SETTINGS_MODULE=opentreemap.settings

RUN apt-get update && apt-get install -y --no-install-recommends \
    binutils \
    build-essential \
    curl \
    gcc \
    gettext \
    gdal-bin \
    libgdal-dev \
    libgeos-dev \
    libjpeg62-turbo-dev \
    libpq-dev \
    libproj-dev \
    postgresql-client \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Bring only the legacy Node 14 runtime and the already-resolved frontend
# dependency tree into Bookworm. No Bullseye apt repositories are used here.
COPY --from=frontend-deps /usr/local/bin/node /usr/local/bin/node

WORKDIR /app
COPY --from=frontend-deps /frontend/node_modules /app/node_modules
COPY requirements.txt package.json /app/

RUN node --version && \
    python --version && \
    python -m pip install --upgrade 'pip<25' 'setuptools<71' wheel && \
    python -m pip install -r /app/requirements.txt

COPY . /app

RUN chmod +x /app/docker/entrypoint.sh /app/docker/worker-entrypoint.sh && \
    mkdir -p /tmp/otm/static /tmp/otm/media

WORKDIR /app/opentreemap
EXPOSE 8000

ENTRYPOINT ["/app/docker/entrypoint.sh"]
CMD ["gunicorn", "opentreemap.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2", "--timeout", "120", "--access-logfile", "-"]
