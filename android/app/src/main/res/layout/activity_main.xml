<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/otn_cream">

    <com.google.android.gms.maps.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/statusBarScrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@color/otn_green_dark"
        android:elevation="11dp" />

    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="top"
        android:background="@drawable/top_panel"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="10dp">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/logo_badge">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:padding="3dp"
                android:src="@drawable/ic_tree" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/status_ready"
                android:textColor="@color/otn_header_subtitle"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/account"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/round_icon_button_header"
            android:contentDescription="@string/account"
            android:padding="9dp"
            android:src="@drawable/ic_account"
            android:tint="@color/white" />

        <ImageButton
            android:id="@+id/refresh"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/round_icon_button_header"
            android:contentDescription="@string/refresh"
            android:padding="9dp"
            android:src="@drawable/ic_refresh"
            android:tint="@color/white" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/filterBar"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top"
        android:layout_marginStart="14dp"
        android:background="@drawable/filter_bar"
        android:elevation="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/filterAll"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/chip_active"
            android:gravity="center"
            android:minWidth="68dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/filter_all"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterMonumental"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/chip_inactive"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/filter_monumental"
            android:textColor="@color/otn_navy"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mapControls"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/addTree"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/round_icon_button"
            android:contentDescription="@string/add_tree"
            android:elevation="7dp"
            android:padding="11dp"
            android:src="@drawable/ic_add"
            android:tint="@color/otn_green" />

        <ImageButton
            android:id="@+id/layers"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/round_icon_button"
            android:contentDescription="@string/layers"
            android:elevation="7dp"
            android:padding="11dp"
            android:src="@drawable/ic_layers"
            android:tint="@color/otn_navy" />

        <ImageButton
            android:id="@+id/location"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/round_icon_button"
            android:contentDescription="@string/my_location"
            android:elevation="7dp"
            android:padding="11dp"
            android:src="@drawable/ic_location"
            android:tint="@color/otn_green" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/treeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/sheet_surface"
        android:elevation="14dp"
        android:orientation="vertical"
        app:behavior_fitToContents="true"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp"
        android:visibility="visible">

        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/sheet_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/tree_card_icon_bg">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:padding="3dp"
                    android:src="@drawable/ic_tree" />
            </FrameLayout>

            <TextView
                android:id="@+id/treeBadge"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/chip_active"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/badge_tree"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/closeTreeCard"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/close"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                android:tint="@color/otn_text_muted" />
        </LinearLayout>

        <TextView
            android:id="@+id/treeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/otn_navy"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/treeScientific"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/otn_green"
            android:textSize="15sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/treeDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:maxLines="2"
            android:textColor="@color/otn_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/treeMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:maxLines="2"
            android:textColor="@color/otn_text_muted"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/botanicalCard"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:backgroundTint="@color/otn_green"
                android:minWidth="0dp"
                android:text="@string/open_botanical_card"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/editTree"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/otn_gold"
                android:minWidth="0dp"
                android:text="@string/edit_tree"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
