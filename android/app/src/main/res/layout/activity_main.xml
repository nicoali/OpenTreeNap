<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/otn_cream">

    <com.google.android.gms.maps.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/top_panel"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/app_name"
            android:padding="4dp"
            android:src="@drawable/ic_tree" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/otn_navy"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/status_ready"
                android:textColor="@color/otn_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/refresh"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/round_icon_button"
            android:contentDescription="@string/refresh"
            android:padding="10dp"
            android:src="@drawable/ic_refresh"
            android:tint="@color/otn_green" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="88dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/filterAll"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/chip_active"
            android:gravity="center"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:text="@string/filter_all"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterMonumental"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/chip_inactive"
            android:gravity="center"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:text="@string/filter_monumental"
            android:textColor="@color/otn_navy"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mapControls"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="22dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/layers"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/round_icon_button"
            android:contentDescription="@string/layers"
            android:elevation="6dp"
            android:padding="11dp"
            android:src="@drawable/ic_layers"
            android:tint="@color/otn_navy" />

        <ImageButton
            android:id="@+id/location"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/round_icon_button"
            android:contentDescription="@string/my_location"
            android:elevation="6dp"
            android:padding="11dp"
            android:src="@drawable/ic_location"
            android:tint="@color/otn_green" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/treeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="@drawable/tree_card"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/treeBadge"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/chip_active"
                android:gravity="center"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:text="@string/badge_tree"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/closeTreeCard"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/close"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                android:tint="@color/otn_text_muted" />
        </LinearLayout>

        <TextView
            android:id="@+id/treeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/otn_navy"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/treeScientific"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/otn_green"
            android:textSize="14sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/treeDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:textColor="@color/otn_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/treeMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/otn_text_muted"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
