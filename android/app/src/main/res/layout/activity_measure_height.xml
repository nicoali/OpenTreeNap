<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/otn_navy"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D917324D"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="42dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/measure_height_title"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/measureArStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#D9FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/measureLiveAngle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/tree_image_source_badge"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="170dp">

        <androidx.camera.view.PreviewView
            android:id="@+id/measurePreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="performance"
            app:scaleType="fillCenter" />

        <View
            android:layout_width="2dp"
            android:layout_height="76dp"
            android:layout_gravity="center"
            android:background="@color/white" />

        <View
            android:layout_width="76dp"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:background="@color/white" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/tree_sheet_surface"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/measureInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/measure_height_instruction"
            android:textColor="@color/otn_navy"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/measureDistanceLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/measure_distance">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/measureDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/measureBase"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="@string/measure_base"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/otn_green"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/measureTop"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/measure_top"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/otn_navy"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/measureCaptured"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/otn_text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/measureResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/tree_detail_panel"
            android:padding="12dp"
            android:textColor="@color/otn_navy"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/measureGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="@string/how_to_measure"
            android:textColor="@color/otn_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/measureCancel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/otn_navy"
                app:cornerRadius="14dp"
                app:strokeColor="@color/otn_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/measureSave"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/confirm_measurement"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/otn_gold"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
