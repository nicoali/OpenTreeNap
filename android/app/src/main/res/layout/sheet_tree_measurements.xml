<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sheet_surface"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="10dp"
    android:paddingEnd="22dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/tree_measurements"
        android:textColor="@color/otn_navy"
        android:textSize="23sp" />

    <TextView
        android:id="@+id/measureTreeName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/otn_green"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/measureCurrentValues"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/tree_detail_panel"
        android:padding="12dp"
        android:textColor="@color/otn_text"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/measureManual"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:text="@string/measure_manual"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:backgroundTint="@color/otn_green"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_edit"
        app:iconGravity="textStart"
        app:iconTint="@color/white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/measureSmartphoneHeight"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="@string/measure_smartphone_height"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:backgroundTint="@color/otn_navy"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_measure"
        app:iconGravity="textStart"
        app:iconTint="@color/white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/measureSmartphoneCircumference"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:enabled="false"
        android:text="@string/measure_smartphone_circumference_next"
        android:textAllCaps="false"
        android:textColor="@color/otn_text_muted"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_measure"
        app:iconGravity="textStart"
        app:iconTint="@color/otn_text_muted"
        app:strokeColor="@color/otn_border" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/measureDeferred"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:text="@string/measure_deferred"
        android:textAllCaps="false"
        android:textColor="@color/otn_navy"
        app:cornerRadius="14dp"
        app:strokeColor="@color/otn_border" />

    <TextView
        android:id="@+id/measureHowTo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:padding="6dp"
        android:text="@string/how_to_measure"
        android:textColor="@color/otn_green"
        android:textSize="12sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/measureClose"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:text="@string/close"
        android:textAllCaps="false"
        android:textColor="@color/otn_text_muted" />
</LinearLayout>